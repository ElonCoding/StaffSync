# StaffSync Server Environment Configuration Example

# Port on which the Express server listens
PORT=5000

# MongoDB Connection URI (e.g., mongodb://localhost:27017/staffsync or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/staffsync

# JSON Web Token secret for signing session tokens
JWT_SECRET=your_jwt_secret_key_change_in_production

# JWT expiration duration
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin for Cross-Origin Resource Sharing (CORS)
CLIENT_ORIGIN=http://localhost:3000
